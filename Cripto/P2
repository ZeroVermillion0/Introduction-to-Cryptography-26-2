#include <stdio.h>

int gcd(int a, int b) {
    int temp;
    while (b != 0) {
        temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

int modInverse(int a, int m) {
    int m0 = m, t, q;
    int x0 = 0, x1 = 1;

    if (m == 1) return 0;

    while (a > 1) {
        q = a / m;
        t = m;
        m = a % m, a = t;
        t = x0;
        x0 = x1 - q * x0;
        x1 = t;
    }

    if (x1 < 0) x1 += m0;

    return x1;
}

int main() {
    int n, a, b;
    int isValid = 0;

    printf("SSISTEMA DE CIFRADO\n");

    while (!isValid) {
        printf("\nIngrese el valor del modulo (n): ");
        scanf("%d", &n);
        printf("Ingrese el valor de alfa (a): ");
        scanf("%d", &a);
        printf("Ingrese el valor de beta (b): ");
        scanf("%d", &b);

        if (a >= n || b >= n || a <= 0 || b < 0) {
            printf("Alfa y beta deben ser menores que n y positivos. Intenta de nuevo.\n");
            continue;
        }

        if (gcd(a, n) != 1) {
            printf("Alfa no tiene inverso multiplicativo modulo %d, Usa otro alfa.\n", a, n);
            continue;
        }

        isValid = 1;
    }

    int a_inv = modInverse(a, n);
    int minus_b_mod = (n - (b % n)) % n;
    int dk2_const = (a_inv * minus_b_mod) % n;

    printf("Funcion de cifrado:      EK     C=%dp+%d mod %d\n", a, b, n);
    printf("Funciones de descifrado: DK1    p=%d[C+%d] mod %d\n", a_inv, minus_b_mod, n);
    printf("                         DK2    p=%dC+%d mod %d\n", a_inv, dk2_const, n);

    return 0;
}